# ---------------------------------------------------------------
# Template for the project's secrets and connection topology.
#
# Copy this file to `.env` in the same directory and fill in the
# values for this machine. `.env` is git-ignored and must never be
# committed. This file is committed and must never hold a value.
#
#   cp .env.example .env
#
# Loaded by src/shared/env.py at import, from the repo root -
# independent of the working directory you run scripts from.
# ---------------------------------------------------------------

# --- PostgreSQL (required; PG_PORT defaults to 5432) ------------
# Consumed by src/shared/config_pg.py -> every pipeline, script,
# and the FastAPI backend in web/api.
PG_HOST=
PG_PORT=
PG_DBNAME=
PG_USER=
PG_PASSWORD=

# --- FMS / SQL Server -------------------------------------------
# Consumed by src/vendors/fms.py.
# FMS_SERVER and FMS_DATABASE are required.
#
# Auth mode is chosen by whether FMS_USER is set:
#   FMS_USER set    -> SQL auth (FMS_PASSWORD then also required)
#   FMS_USER unset  -> Windows / Trusted_Connection
#
# The correct mode has not been confirmed with the DBA - see
# ROTATION.md. Leave FMS_USER/FMS_PASSWORD blank to use Trusted.
FMS_SERVER=
FMS_DATABASE=
FMS_USER=
FMS_PASSWORD=

# --- LVA portal (required by the LVA scraper) -------------------
# Consumed by src/scrapers/lva.py.
LVA_USER=
LVA_PASSWORD=

# --- Configuracion de esta maquina ------------------------------
# Consumido por src/configs/machine_config.py.
#
# Que puede hacer ESTA computadora. La alternativa es el archivo
# %USERPROFILE%\Documents\Tools\config\market_data_config.yaml, que vive
# fuera del repo; lo que se declare AQUI tiene prioridad sobre ese
# archivo, y permite instalar el proyecto sin crearlo.
#
# Para el tablero SPP solo hace falta SCRAPER_ENABLED (la extraccion
# abre un Chrome visible contra la SBS). Vacio = false.
#   SCRAPER_ENABLED=true
MACHINE_ID=
SCRAPER_ENABLED=
# Solo en la maquina con terminal Bloomberg.
BLOOMBERG_ENABLED=
# Solo en la maquina con acceso a FMS (SQL Server).
FMS_ENABLED=

# --- DATA_DIR override ------------------------------------------
# Consumed by src/shared/paths.py.
#
# Vacio = la carpeta `data` HERMANA de la carpeta del repo. Es decir,
# si el repo esta en C:\...\Proyectos\pap, los datos van a
# C:\...\Proyectos\data: el perfil de Chrome con la cookie del WAF
# (data\browser_profile_spp), el rastro de la extraccion diaria
# (data\spp\extraccion.log y .json), los logs y los crudos.
#
# Conviene FIJARLA en una maquina nueva: si el zip del repo se
# descomprime en Descargas y se deja ahi, la carpeta de datos nace en
# Descargas y se pierde al mover el proyecto. Ejemplo:
#   DATA_DIR=C:\Users\<usuario>\Documents\Proyectos\data
DATA_DIR=

# --- SBS legacy landing directory (optional) --------------------
# Consumed by src/scrapers/sbs.py as VP_SBS_DIR_LEGACY. A network
# share, so it is site-specific. Leave blank if this machine does not
# use the --legacy acquisition paths.
#   e.g. SBS_LEGACY_DIR=\\FILESERVER\Share\Vectores de precios
SBS_LEGACY_DIR=
