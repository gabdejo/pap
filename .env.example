# ---------------------------------------------------------------
# Template for the project's secrets and connection topology.
#
# Copy this file to `.env` in the same directory and fill in the
# values for this machine. `.env` is git-ignored and must never be
# committed. This file is committed and must never hold a value.
#
#   cp .env.example .env
#
# Loaded by src/shared/env.py at import, from the repo root -
# independent of the working directory you run scripts from.
# ---------------------------------------------------------------

# --- PostgreSQL (required; PG_PORT defaults to 5432) ------------
# Consumed by src/shared/config_pg.py -> every pipeline, script,
# and the FastAPI backend in web/api.
PG_HOST=
PG_PORT=
PG_DBNAME=
PG_USER=
PG_PASSWORD=

# --- FMS / SQL Server -------------------------------------------
# Consumed by src/vendors/fms.py.
# FMS_SERVER and FMS_DATABASE are required.
#
# Auth mode is chosen by whether FMS_USER is set:
#   FMS_USER set    -> SQL auth (FMS_PASSWORD then also required)
#   FMS_USER unset  -> Windows / Trusted_Connection
#
# The correct mode has not been confirmed with the DBA - see
# ROTATION.md. Leave FMS_USER/FMS_PASSWORD blank to use Trusted.
FMS_SERVER=
FMS_DATABASE=
FMS_USER=
FMS_PASSWORD=

# --- LVA portal (required by the LVA scraper) -------------------
# Consumed by src/scrapers/lva.py.
LVA_USER=
LVA_PASSWORD=

# --- This machine's capabilities --------------------------------
# Consumed by src/configs/machine_config.py.
#
# What THIS computer is allowed to do. The alternative is the file
# %USERPROFILE%\Documents\Tools\config\market_data_config.yaml, which
# lives outside the repo; whatever is declared HERE takes precedence
# over that file, and lets a machine be set up without creating it.
# Empty = unset (the yaml value, or false).
#   SCRAPER_ENABLED=true
#
# The *_ENABLED flags only PERMIT running a pipeline here; they do not
# schedule it. The scheduler runs the jobs whose `machine` field in
# config/schedules.yaml names this MACHINE_ID ('i7', 'bloomberg-ws').
# Any other id - a laptop, a test box - schedules nothing.
MACHINE_ID=
SCRAPER_ENABLED=
# Only on the machine with the Bloomberg terminal.
BLOOMBERG_ENABLED=
# Only on the machine with FMS (SQL Server) access.
FMS_ENABLED=

# --- DATA_DIR override ------------------------------------------
# Consumed by src/shared/paths.py.
#
# Empty = the `data` folder that is a SIBLING of the repo folder: with
# the repo at C:\...\Proyectos\pap, data goes to C:\...\Proyectos\data
# (raw files, logs, browser profiles). Worth PINNING on a new machine:
# if the repo zip is unpacked in Downloads and left there, the data
# folder is born in Downloads and is lost when the project moves.
#   DATA_DIR=C:\Users\<user>\Documents\Proyectos\data
DATA_DIR=

# --- SBS legacy landing directory (optional) --------------------
# Consumed by src/scrapers/sbs.py as VP_SBS_DIR_LEGACY. A network
# share, so it is site-specific. Leave blank if this machine does not
# use the --legacy acquisition paths.
#   e.g. SBS_LEGACY_DIR=\\FILESERVER\Share\Vectores de precios
SBS_LEGACY_DIR=
